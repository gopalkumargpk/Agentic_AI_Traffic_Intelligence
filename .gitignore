# Agentic AI Traffic Intelligence — .gitignore

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.env
.venv/
venv/
env/

# Database & SQLite Journals
*.db
*.db-journal
data/traffic_intelligence.db
data/traffic_intelligence.db-journal
data/*.db
data/*.db-journal

# Runtime Generated Data & Logs
data/raw/*
data/results/*
logs/*
*.log

# Models (large generated artifacts)
models/*.pkl
models/*.h5
models/*.pt
models/*.onnx

# SUMO Temporary Outputs
*.xml.gz

# Frontend Build & Cache
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# OS Specific
.DS_Store
Thumbs.db
desktop.ini
